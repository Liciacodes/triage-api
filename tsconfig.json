{
  "compilerOptions": {
    "target": "ES2022",
    "module": "preserve",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "types": [
      "node"
    ],
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "outDir": "dist"
  },
  "include": [
     "src/**/*.ts",
    "prisma.config.ts"
  ], 
  "exclude": [
      "node_modules",
    "dist",
    "src/**/*.test.ts"
  ]
}